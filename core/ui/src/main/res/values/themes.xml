<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MoexMonitor" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="android:colorBackground">@color/surface_app</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/surface_app</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="deltaPositiveColor">@color/market_up</item>
        <item name="deltaNegativeColor">@color/market_down</item>
        <item name="deltaNeutralColor">@color/market_neutral</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Текстовые стили: один раз здесь, дальше только @style/... в layout'ах. -->
    <style name="TextAppearance.Moex.Ticker" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.Moex.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.Moex.Price" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Moex.PriceLarge" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.Moex.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/divider</item>
    </style>

    <style name="Widget.Moex.Delta" parent="Widget.AppCompat.TextView">
        <item name="android:textAppearance">@style/TextAppearance.Moex.Price</item>
        <item name="deltaShowChip">true</item>
        <item name="deltaChipAlpha">0.14</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
